---
import Header from "$components/Header.astro";
import Footer from "$components/Footer.astro";
import BaseLayout from "$layouts/BaseLayout.astro";
import TalkLanguages from "$components/TalkLanguages.astro";
import { SITE_NAME } from "../../config.json";
import { getVisibleTalks, talkPath } from "../../talks/catalog";

export async function getStaticPaths() {
	const talks = await getVisibleTalks();
	return talks.length ? [{ params: { index: undefined }, props: { talks } }] : [];
}

const { talks } = Astro.props;
---

<BaseLayout title={`Talks · ${SITE_NAME}`} description="Slide decks from William Oliveira’s talks." showSupportWidget={false}>
  <Header active="talks" />
  <main class="max-w-3xl mx-auto my-16 px-6 text-base-900 dark:text-base-100">
    <h1 class="mb-10 text-5xl font-bold">Talks</h1>
    <ul class="space-y-8">
      {talks.map(({ slug, editions }) => {
        const { data } = editions[0];
        return (
          <li class="border-t border-base-300 dark:border-base-700 pt-6">
            <a lang={data.lang} class="text-2xl font-semibold underline decoration-accent-500 underline-offset-4" href={talkPath(slug, data.lang)}>{data.title}</a>
            <p lang={data.lang} class="mt-3">{data.description}</p>
            <TalkLanguages {slug} languages={editions.map(({ data }) => data.lang)} />
            {!data.published && <p class="mt-2 text-sm">Draft</p>}
          </li>
        );
      })}
    </ul>
  </main>
  <Footer />
</BaseLayout>
