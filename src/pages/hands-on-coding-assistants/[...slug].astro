---
import BookRedirect from "$components/books/BookRedirect.astro";
import { book } from "../../books/hands-on-coding-assistants.book";
import { getBookRedirects } from "../../books/legacy-redirects";

export function getStaticPaths() {
	return getBookRedirects(book, import.meta.env.MODE, {
		"ch-04-spec-driven-development": "ch-02-the-spec-first-workflow",
	});
}
---

<BookRedirect destination={Astro.props.destination} />
