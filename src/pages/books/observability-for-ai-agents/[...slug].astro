---
import { getCollection, getEntry, render } from "astro:content";
import { jsx } from "astro/jsx-runtime";
import type { HTMLAttributes } from "astro/types";
import BookCover from "$components/books/BookCover.astro";
import ChapterContents from "$components/books/ChapterContents.astro";
import BookLayout from "$layouts/BookLayout.astro";
import ProseWrapper from "$layouts/ProseWrapper.astro";
import { isBookAvailable } from "../../../books/design";
import { book } from "../../../books/observability.book";
import { bookHref, contents, getReadingOrder, type ReadingPage } from "../../../books/observability";

export async function getStaticPaths() {
	if (!isBookAvailable(book, import.meta.env.MODE)) return [];

	const readingOrder = getReadingOrder(await getCollection("observabilitySeries"));
	return [undefined, contents.slug, ...readingOrder.map(({ slug }) => slug)].map((slug) => ({
		params: { slug },
		props: { readingOrder },
	}));
}

interface Props {
	readingOrder: ReadingPage[];
}

const { readingOrder } = Astro.props;
const { slug } = Astro.params;
const pageIndex = readingOrder.findIndex((page) => page.slug === slug);
const page = readingOrder[pageIndex];
const isCover = slug === undefined;
const isContents = slug === contents.slug;
const contentsHref = bookHref(contents.slug);
const previous = readingOrder[pageIndex - 1];
const next = page && readingOrder[pageIndex + 1];
const sourceId = page?.sourceId;
const entry = sourceId ? await getEntry("observabilitySeries", sourceId) : undefined;
if (sourceId && !entry) throw new Error(`Missing book source ${sourceId}`);

const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const introductionHeadings = new Map([
	["three-labels-used-throughout-the-series", "How to read the guidance"],
	["what-the-series-produces", "What you will build"],
]);
const headings = rendered?.headings
	.filter(({ depth }) => depth === 2 || depth === 3)
	.map((heading) => slug === "introduction"
		? { ...heading, text: introductionHeadings.get(heading.slug) ?? heading.text }
		: heading) ?? [];
const indexLabel = page?.chapterNumber ? "In this chapter" : "On this page";
const title = isContents ? contents.title : (page?.title ?? book.title);
const description = entry?.data.description.replace(/\bseries\b/g, "book") ?? book.description;
const sections = [...new Set(readingOrder.map(({ section }) => section))];
const sourceLinks = new Map(readingOrder.map((item) => [item.sourceId, bookHref(item.slug)]));

const references = {
	glossary: bookHref("glossary"),
	appendix: bookHref("appendices/telemetry-placement"),
};

// The book supplies its own title. The series continues to render the source H1.
const omitSourceTitle = () => null;

function bookSourceLink({ href, ...attributes }: HTMLAttributes<"a">) {
	const match = href?.toString().match(/^\/observability-ai-agents\/([^/?#]+)\/?([?#].*)?$/);
	const destination = match ? sourceLinks.get(match[1]) : undefined;
	return jsx("a", { ...attributes, href: destination ? `${destination}${match?.[2] ?? ""}` : href });
}

const bookIntroductionHeading = ({ id, children, ...attributes }: HTMLAttributes<"h2"> & { children?: unknown }) => jsx("h2", {
	...attributes,
	id,
	children: (id && introductionHeadings.get(id)) ?? children,
});

const bookGlossaryTable = (attributes: HTMLAttributes<"table">) => jsx("table", {
	...attributes,
	class: "book-glossary-table",
});
---

<BookLayout book={book} title={title} description={description} isCover={isCover} isContents={isContents} contentsHref={contentsHref}>
	{isCover ? (
		<BookCover book={book} startHref={bookHref("introduction")} contentsHref={contentsHref} />
	) : isContents ? (
		<section class="book-contents" aria-labelledby="contents-title">
			<h1 id="contents-title">{contents.title}</h1>
			<div class="book-contents-groups">
				{sections.map((section) => (
					<section>
						<h2>{section}</h2>
						<ul>
							{readingOrder.filter((item) => item.section === section).map((item) => (
								<li><a href={bookHref(item.slug)}>{item.chapterNumber && <span class="book-chapter-number" aria-label={`Chapter ${item.chapterNumber}`}>{item.chapterNumber}</span>}{item.title}</a></li>
							))}
						</ul>
					</section>
				))}
			</div>
			<p class="book-license">This book is licensed under <a href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 International</a>.</p>
		</section>
	) : (
		<div class:list={["book-reading-grid", { "book-with-index": headings.length > 0 }]}>
			{headings.length > 0 && (
				<div class="book-index-desktop">
					<p>{indexLabel}</p>
					<ChapterContents headings={headings} label={indexLabel} />
				</div>
			)}
			<article class:list={["book-reading", { "book-with-notes": slug === "chapters/the-telemetry-data-model" }]} aria-labelledby="book-page-title">
				<header class="book-reading-title">
					{page?.chapterNumber && <p>{page.section} <span aria-hidden="true">/</span> Chapter {page.chapterNumber}</p>}
					<h1 id="book-page-title">{title}</h1>
				</header>
				{headings.length > 0 && (
					<details class="book-index-compact">
						<summary>{indexLabel}</summary>
						<ChapterContents headings={headings} label={indexLabel} />
					</details>
				)}
				<ProseWrapper class="book-prose">
					{Content && <Content book={references} components={{
						h1: omitSourceTitle,
						a: bookSourceLink,
						...(slug === "introduction" ? { h2: bookIntroductionHeading } : {}),
						...(slug === "glossary" ? { table: bookGlossaryTable } : {}),
					}} />}
					{slug === "dedication" && <p class="book-dedication">Dedication to come.</p>}
					{slug === "appendices/telemetry-placement" && (
						<>
							<p>Use this checklist when you add a field to telemetry or review an instrumentation change.</p>
							<dl class="book-glossary">
									<dt>Service identity</dt>
									<dd>Put <code>service.name</code> and the deployment environment on the resource.</dd>
									<dt>Operation context</dt>
									<dd>Record the model name and other operation-specific fields on the span. Use a span event for an occurrence within the operation.</dd>
									<dt>Aggregate measurements</dt>
									<dd>Use histograms for latency and token counts. Keep identifiers such as trace IDs out of metric dimensions.</dd>
								</dl>
							<p>Adapted from <a href={`${bookHref("chapters/the-telemetry-data-model")}#a-modeling-checklist`}>The Telemetry Data Model</a>.</p>
						</>
					)}
				</ProseWrapper>
				<nav class="book-pagination" aria-label="Reading order">
					{previous && (
						<a class="book-previous" rel="prev" href={bookHref(previous.slug)}>
							<span>← Previous</span>
							{previous.title}
						</a>
					)}
					{next && (
						<a class="book-next" rel="next" href={bookHref(next.slug)}>
							<span>Next →</span>
							{next.title}
						</a>
					)}
				</nav>
			</article>
		</div>
	)}
</BookLayout>

<script>
	for (const menu of document.querySelectorAll<HTMLDetailsElement>(".book-index-compact")) {
		menu.addEventListener("click", (event) => {
			if (event.target instanceof Element && event.target.closest("a")) {
				menu.open = false;
			}
		});
	}
</script>
