---
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import { getBlogPosts } from "src/utils";
import AIDisclaimer from "$components/AIDisclaimer.astro";
import Footer from "$components/Footer.astro";
import FormattedDate from "$components/FormattedDate.astro";
import Header from "$components/Header.astro";
import ShareWithGenAI from "$components/ShareWithGenAI.astro";
import Tag from "$components/Tag.astro";
import BaseLayout from "$layouts/BaseLayout.astro";
import BlogPost from "$layouts/BlogPost.astro";
import { NAME, SHOW_IMAGES, SITE } from "../../config.json";

export async function getStaticPaths() {
	const posts = await getBlogPosts();

	// biome-ignore lint/suspicious/noExplicitAny: usage of 'any' required for dynamic post data
	return posts.map((post: any) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const canonical = `${SITE}/posts/${post.id}/`;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.data.title,
	description: post.data.description,
	url: canonical,
	datePublished: post.data.pubDate.toISOString(),
	...(post.data.updatedDate && {
		dateModified: post.data.updatedDate.toISOString(),
	}),
	...(post.data.tags?.length && { keywords: post.data.tags.join(", ") }),
	author: { "@type": "Person", name: NAME, url: SITE },
	publisher: { "@type": "Person", name: NAME, url: SITE },
	mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
};
// Escape "<" to prevent breaking out of the <script> context.
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, "\\u003c");

const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/**/*.{jpeg,jpg,png,gif}",
);
const replacedHero = post.data.heroImage?.replace("../..", "/src");
if (replacedHero && !images[replacedHero])
	throw new Error(
		`"${post.data.heroImage}" does not exist in glob: "src/assets/**/*.{jpeg,jpg,png,gif}"`,
	);
---

<BaseLayout {...post.data} image={post.id + ".png"}>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="text/markdown"
      href={`${SITE}/posts/${post.id}.md`}
    />
    <script type="application/ld+json" set:html={jsonLdString} />
  </Fragment>

  <Header active="blog" />

  <main class="max-w-2xl lg:max-w-3xl mx-auto my-0 h-full p-4">
    {
      replacedHero && post.data.hideHero !== true && SHOW_IMAGES ? (
        <Image
          src={images[replacedHero]()}
          alt=""
          class="w-full h-80 object-cover rounded-xl shadow border border-base-400 dark:border-base-700"
        />
      ) : null
    }
    <BlogPost>
      <h1 class="mt-4">{post.data.title}</h1>
      <ShareWithGenAI slug={post.id} title={post.data.title} />
      <Content />

      <AIDisclaimer />

      <div class="flex mt-8 items-center gap-x-4 text-xs">
        <FormattedDate date={post.data.pubDate} />
        <div class="flex gap-x-2 flex-wrap">
          {post.data.tags?.map((tag: string) => <Tag {tag} />)}
        </div>
        <a
          href={`https://github.com/woliveiras/woliveiras.github.io/blob/main/src/content/blog/${post.id}.mdx`}
          target="_blank"
          rel="noopener"
        >
          Edit this article on GitHub
        </a>
      </div>
    </BlogPost>
  </main>
  <Footer />
</BaseLayout>
