{
	"$schema": "https://opencode.ai/config.json",
	"permissions": [
		{ "action": "shell", "resource": "*", "effect": "ask" },
		{ "action": "shell", "resource": "npm test", "effect": "allow" },
		{ "action": "shell", "resource": "npm run test:registration", "effect": "allow" },
		{ "action": "shell", "resource": "npm run test:labels", "effect": "allow" },
		{ "action": "shell", "resource": "npm run test:mcp", "effect": "allow" },
		{ "action": "external_directory", "resource": "*", "effect": "deny" }
	]
}
