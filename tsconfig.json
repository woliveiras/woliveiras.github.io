{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"strictNullChecks": true,
		"paths": {
			"src/*": ["./src/*"],
			"$lib/*": ["./src/lib/*"],
			"$components/*": ["./src/components/*"],
			"$layouts/*": ["./src/layouts/*"],
			"$pages/*": ["./src/pages/*"],
			"$styles/*": ["./src/styles/*"],
			"$assets/*": ["./src/assets/*"],
			"$examples/*": ["./src/examples/*"]
		}
	},
	"exclude": ["public/pagefind", "dist"]
}
